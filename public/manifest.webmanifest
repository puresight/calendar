{
  "name": "iLife Calendar",
  "short_name": "Calendar",
  "description": "A local-first, offline calendar for events, milestones, and contacts.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "theme_color": "#4f46e5",
  "background_color": "#f3f2fb",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New event",
      "short_name": "New event",
      "url": "/?action=new",
      "description": "Create a new calendar event"
    }
  ]
}
